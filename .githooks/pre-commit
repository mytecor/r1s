#!/usr/bin/env bash
#
# Pre-commit hook for r1s.
#
# Checks that every staged Go file is gofmt-clean. It verifies only files that
# are actually staged, so an unrelated pre-existing formatting problem elsewhere
# in the tree does not block a commit. It does not modify files; run `make fmt`
# (or `gofmt -w`) to fix and re-stage.
#
# Install once with `make install-hooks` (sets core.hooksPath=.githooks), or
# copy this file to .git/hooks/pre-commit and make it executable.
set -euo pipefail

# Fail fast if go is not available; the hook is an aid, not a build gate.
if ! command -v gofmt >/dev/null 2>&1; then
  echo "pre-commit: gofmt not found on PATH; skipping formatting check" >&2
  exit 0
fi

# Collect staged Go files. Handle both plain and renamed (old -> new) statuses.
staged_go_files="$(
  git diff --cached --name-only --diff-filter=ACMR -z |
    tr '\0' '\n' |
    sed -n 's:^\(.*\.go\)$:\1:p'
)"

if [ -z "$staged_go_files" ]; then
  exit 0
fi

# gofmt validates on stdin; drop it into a temp file so `-l` reports a path.
unformatted=""
for file in $staged_go_files; do
  if [ ! -f "$file" ]; then
    continue
  fi
  # gofmt -l <(cat "$file") reports "-" for stdin, so copy to a temp file.
  tmp="$(mktemp "${TMPDIR:-/tmp}/r1s-gofmt.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT
  cp "$file" "$tmp"
  if [ -n "$(gofmt -l "$tmp")" ]; then
    unformatted="$unformatted
$file"
  fi
  rm -f "$tmp"
  trap - EXIT
done

if [ -n "$unformatted" ]; then
  echo "pre-commit: gofmt needed for the following staged files:" >&2
  echo "$unformatted" >&2
  echo >&2
  echo "Fix with:  gofmt -w $staged_go_files  (or 'make fmt')" >&2
  echo "Then re-stage the fixed files and commit again." >&2
  exit 1
fi

exit 0
